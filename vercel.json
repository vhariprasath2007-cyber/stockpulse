{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "frontend/stockpulse-ui/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "destination": "https://stockpulse-api.onrender.com/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/frontend/stockpulse-ui/$1"
    }
  ]
}
